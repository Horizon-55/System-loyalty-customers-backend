#!/bin/sh
# Git Pre-Commit Hook: Automated Secret Leak Prevention via Gitleaks
echo "[pre-commit] Scanning staged changes for credentials..."

node scripts/scan-secrets.js git --staged -v
EXIT_CODE=$?

if [ $EXIT_CODE -ne 0 ]; then
    echo ""
    echo "================================================================================"
    echo " [SECURITY ALERT] Gitleaks detected secrets in staged files!"
    echo " Commit has been BLOCKED to prevent credential leakage into git history."
    echo " Remediation: Move secrets to .env, update .env.example, and unstage the secret."
    echo "================================================================================"
    echo ""
    exit 1
fi

echo "[pre-commit] Secrets check passed clean. Proceeding with commit."
exit 0
