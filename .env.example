# ==============================================================================
# Environment Configuration Template (.env.example)
# Safe, version-controlled template containing NO confidential data or tokens.
# Copy to .env and configure local secret values for development.
# ==============================================================================

# Server Environment
NODE_ENV=development
PORT=3000

# Gateway & AWS Credentials (Loaded dynamically by loadGatewayConfig)
AWS_ACCESS_KEY_ID=your_aws_access_key_id_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key_here
AWS_REGION=eu-central-1
GATEWAY_SERVICE_NAME=Loyalty-Gateway-Development

# External Integrations
GITHUB_API_TOKEN=your_github_token_here
SONAR_TOKEN=your_sonarqube_token_here
